{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(cp /tmp/cloud-architecture-review-workspace/iteration-1/*/eval_metadata.json /tmp/cloud-architecture-review-workspace/iteration-2/multi-cdn-ecommerce/)",
      "Bash(cp /tmp/cloud-architecture-review-workspace/iteration-1/data-platform-gcp/eval_metadata.json /tmp/cloud-architecture-review-workspace/iteration-2/data-platform-gcp/)",
      "Bash(cp /tmp/cloud-architecture-review-workspace/iteration-1/startup-mvp/eval_metadata.json /tmp/cloud-architecture-review-workspace/iteration-2/startup-mvp/)",
      "Bash(nohup python *)",
      "Read(//tmp/**)",
      "mcp__visualize__read_me",
      "mcp__visualize__show_widget",
      "Bash(git submodule *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh",
            "statusMessage": "セキュリティチェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-save.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-slack.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
