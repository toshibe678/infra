# Claude Code環境変数設定例
# このファイルをセルフホストランナーの環境に配置してください
# 例: /home/runner/.config/claude-code/.env

# LLM Proxy設定
OPENAI_API_BASE=http://llm-proxy.abe365.org/v1
LITELLM_MASTER_KEY=your-litellm-master-key-here

# 使用するClaudeモデル（推奨: フォールオーバー対応モデル）
CLAUDE_MODEL=claude-3-sonnet-fallback

# オプション: 詳細ログを有効化（デバッグ時）
# LITELLM_LOG=DEBUG

# オプション: タイムアウト設定（秒）
# REQUEST_TIMEOUT=300

# オプション: 最大トークン数
# MAX_TOKENS=4000

# 言語設定
LANG=ja_JP.UTF-8
LC_ALL=ja_JP.UTF-8
