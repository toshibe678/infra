# Managed by Ansible - DO NOT EDIT MANUALLY
# Backend: {{ item.name }}

upstream {{ item.name }}_backend {
    server {{ item.upstream_host }}:{{ item.upstream_port }};
    # Add more servers for load balancing if needed
    # server {{ item.upstream_host }}:{{ item.upstream_port }} backup;
}

server {
    listen 80;
    server_name {{ item.server_name }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ item.server_name }};

    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Rate limiting
    limit_req zone=general burst={{ vpn_proxy_burst }} nodelay;
    limit_conn conn_limit {{ vpn_proxy_conn_limit }};

    # Logging
    access_log /var/log/nginx/{{ item.name }}.access.log proxy_log;
    error_log /var/log/nginx/{{ item.name }}.error.log warn;

    location / {
        proxy_pass http://{{ item.name }}_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

{% if item.websocket | default(false) %}
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

{% endif %}
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout {{ item.proxy_read_timeout | default('60s') }};
        proxy_read_timeout {{ item.proxy_read_timeout | default('60s') }};

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
}
