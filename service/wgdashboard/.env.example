# WGDashboard Configuration

# Environment: 'prod' or 'dev'
# prod: vpn.toshi.click - Internet accessible with Let's Encrypt SSL
# dev: vpn-dev.abe365.org - Internal network only, HTTP without SSL
ENVIRONMENT=dev

# Basic Authentication (nginx layer)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change_this_password

# WGDashboard Web Interface Authentication (app layer)
# Official environment variables: username, password
WGDASHBOARD_USERNAME=admin
WGDASHBOARD_PASSWORD=change_this_password

# Timezone
TZ=Asia/Tokyo
