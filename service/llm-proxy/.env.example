# LLM Proxy Configuration

# LiteLLM
LITELLM_MASTER_KEY=sk-your-master-key-here
LITELLM_LOG=INFO
STORE_MODEL_IN_DB=True

UI_USERNAME=admin                 # username to sign in on UI
UI_PASSWORD=your-ui-password-here # password to sign in on UI
DOCS_URL="/docs"              # Set docs to a different path
ROOT_REDIRECT_URL="/ui"       # Redirect root path (/) to /ui

# Database
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://llmproxy:your-db-password-here@db:5432/litellm

# Redis
REDIS_PASSWORD=your-redis-password-here

# LLM Provider API Keys (add as needed)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AZURE_API_KEY=your-azure-key
AZURE_API_BASE=https://your-endpoint.openai.azure.com

# AWS Bedrock
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION_NAME=us-east-1

# AWS Bedrock Cross-Region Inference Profile ARNs
BEDROCK_NOVA_MICRO_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.amazon.nova-micro-v1:0
BEDROCK_NOVA_LITE_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.amazon.nova-lite-v1:0
BEDROCK_NOVA_PRO_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.amazon.nova-pro-v1:0
BEDROCK_NOVA2_LITE_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.amazon.nova-2-lite-v1:0
BEDROCK_CLAUDE_SONNET_4_5_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_CLAUDE_HAIKU_4_5_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_CLAUDE_OPUS_4_5_ARN=bedrock/arn:aws:bedrock:us-east-1:your-aws-account-id:inference-profile/us.anthropic.claude-opus-4-5-20251101-v1:0

# Google Cloud Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
# Option 1: サービスアカウントJSONファイルのパス（推奨）
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
# Option 2: サービスアカウントJSONの内容（Base64エンコード推奨）
GOOGLE_APPLICATION_CREDENTIALS_JSON=/app/gcp-credentials.json
