# LLM Proxy Configuration

# LiteLLM
LITELLM_MASTER_KEY=sk-your-master-key-here
LITELLM_LOG=INFO
STORE_MODEL_IN_DB=True

UI_USERNAME=admin                 # username to sign in on UI
UI_PASSWORD=your-ui-password-here # password to sign in on UI
DOCS_URL="/docs"              # Set docs to a different path
ROOT_REDIRECT_URL="/ui"       # Redirect root path (/) to /ui

# Database
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://llmproxy:your-db-password-here@db:5432/litellm

# Redis
REDIS_PASSWORD=your-redis-password-here

# LLM Provider API Keys (add as needed)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AZURE_API_KEY=your-azure-key
AZURE_API_BASE=https://your-endpoint.openai.azure.com

# AWS Bedrock
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION_NAME=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id

# Google Cloud Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
# Option 1: サービスアカウントJSONファイルのパス（推奨）
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
# Option 2: サービスアカウントJSONの内容（Base64エンコード推奨）
GOOGLE_APPLICATION_CREDENTIALS_JSON=/app/gcp-credentials.json
