# Example backend proxy configurations
# Copy this file to proxy-backends.conf and customize for your environment

# Example 1: Development Server Proxy
upstream develop_backend {
    server 192.168.100.55:8080;
    # Add more servers for load balancing if needed
    # server 192.168.100.55:8081 backup;
}

server {
    listen 80;
    server_name develop-proxy.vpn.local;

    # Rate limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn conn_limit 10;

    # Logging
    access_log /var/log/nginx/develop-proxy.access.log proxy_log;
    error_log /var/log/nginx/develop-proxy.error.log warn;

    location / {
        proxy_pass http://develop_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
}

# Example 2: Monitoring Server Proxy (Grafana)
upstream monitoring_backend {
    server 192.168.100.51:3000;
}

server {
    listen 80;
    server_name monitoring-proxy.vpn.local;

    # Rate limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn conn_limit 10;

    # Logging
    access_log /var/log/nginx/monitoring-proxy.access.log proxy_log;
    error_log /var/log/nginx/monitoring-proxy.error.log warn;

    location / {
        proxy_pass http://monitoring_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for Grafana Live
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Example 3: AI Test Server Proxy
upstream ai_test_backend {
    server 192.168.100.56:8080;
}

server {
    listen 80;
    server_name ai-test-proxy.vpn.local;

    # Rate limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn conn_limit 10;

    # Logging
    access_log /var/log/nginx/ai-test-proxy.access.log proxy_log;
    error_log /var/log/nginx/ai-test-proxy.error.log warn;

    location / {
        proxy_pass http://ai_test_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts (longer for AI processing)
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}

# Example 4: MCP Servers - Model Context Protocol Unified Gateway
upstream mcp_backend {
    server 192.168.100.57:80;
}

server {
    listen 80;
    server_name mcp-proxy.vpn.local;

    # Rate limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn conn_limit 10;

    # Logging
    access_log /var/log/nginx/mcp-proxy.access.log proxy_log;
    error_log /var/log/nginx/mcp-proxy.error.log warn;

    location / {
        proxy_pass http://mcp_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Pass through Authorization header (required for Bearer token auth)
        proxy_pass_request_headers on;

        # WebSocket support (required for some MCP operations)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts (extended for long-running operations like Playwright/Git)
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
}

