# Environment
ENVIRONMENT=dev  # dev or prod
TZ=Asia/Tokyo

# Proxy Port (HTTP only - VPN internal network)
PROXY_HTTP_PORT=80

# Backend Servers (non-VPN servers in the local network)
# Example: server_name -> upstream_host:port
# Add your backend servers here

# Example 1: Development Server
DEV_SERVER_HOST=192.168.100.55
DEV_SERVER_PORT=8080

# Example 2: AI Test Server
AI_TEST_SERVER_HOST=192.168.100.56
AI_TEST_SERVER_PORT=8080

# Example 3: Monitoring Server
MONITORING_SERVER_HOST=192.168.100.51
MONITORING_SERVER_PORT=3000

# Example 4: Custom Backend Server
# BACKEND_SERVER_1_HOST=192.168.x.x
# BACKEND_SERVER_1_PORT=xxxx

# Security Configuration
# ALLOWED_VPN_SUBNET=10.0.0.0/24
