auths:
  public_v2:
    community: "public"
    version: 2

modules:
  if_mib:
    walk:
      - 1.3.6.1.2.1.1.3           # sysUpTime
      - 1.3.6.1.2.1.2.2           # ifTable
      - 1.3.6.1.2.1.31.1.1        # ifXTable
    lookups:
      - source_indexes: [ifIndex]
        lookup: ifDescr
      - source_indexes: [ifIndex]
        lookup: ifName
    overrides:
      ifDescr:
        ignore: true
      ifName:
        ignore: true
      ifType:
        type: EnumAsInfo